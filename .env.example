# ==============================================================================
# SmartOMR — Local & Development Environment Template
# Copy this file to .env (or backend/.env) for local testing
# ==============================================================================

# --- Backend Core Settings ---
SECRET_KEY=smartomr_super_secret_development_key_change_in_prod_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Configuration ---
# Local SQLite fallback:
DATABASE_URL=sqlite:///./smartomr.db
# Or test with Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Cloud Storage (Supabase Storage) ---
# Leave empty to use local disk storage in ./uploads and ./annotated
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=omr-sheets

# --- CORS & Networking ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_URL=http://localhost:8000

# --- OMR Computer Vision Parameters ---
BUBBLE_FILLED_THRESHOLD=0.32
BUBBLE_EMPTY_THRESHOLD=0.15
CONFIDENCE_THRESHOLD=0.75

# --- Frontend Configuration (Set in frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
