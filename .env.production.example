# ==============================================================================
# SmartOMR — Production Environment Variables Template
#
# Use these environment variables when configuring:
# 1. Render Web Service (Backend)
# 2. Vercel Project (Frontend)
#
# DO NOT COMMIT ACTUAL PASSWORDS OR CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# RENDER BACKEND ENVIRONMENT VARIABLES (Set in Render Dashboard -> Environment)
# ------------------------------------------------------------------------------

# 1. Application Security
# Generate a strong 64-char key: `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=replace_with_a_long_random_secret_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 2. Supabase PostgreSQL Database URL
# In Supabase -> Project Settings -> Database -> Connection string -> URI
# Note: Use port 5432 (direct) or port 6543 (transaction pooler)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require

# 3. Supabase Cloud Storage (For persistent OMR scans & annotated review images)
# In Supabase -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY-OR-ANON-KEY]
SUPABASE_STORAGE_BUCKET=omr-sheets

# 4. CORS Origins (Strictly restrict to your Vercel deployment URL)
# Include your custom domain or Vercel preview domain(s)
CORS_ORIGINS=https://smartomr.vercel.app,https://your-custom-domain.com

# 5. Backend Public URL (Your Render service URL)
BACKEND_URL=https://smartomr-backend.onrender.com

# 6. Computer Vision Tuning (Optional production defaults)
BUBBLE_FILLED_THRESHOLD=0.32
BUBBLE_EMPTY_THRESHOLD=0.15
CONFIDENCE_THRESHOLD=0.75


# ------------------------------------------------------------------------------
# VERCEL FRONTEND ENVIRONMENT VARIABLES (Set in Vercel Dashboard -> Settings -> Environment Variables)
# ------------------------------------------------------------------------------

# Points Next.js frontend to your live Render FastAPI backend
NEXT_PUBLIC_API_URL=https://smartomr-backend.onrender.com
